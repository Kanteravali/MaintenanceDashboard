@model List<MaintenanceDashboard.Models.MaintenanceRequest>

@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h1>Maintenance Requests</h1>
            <p>Manage equipment maintenance requests</p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            Create Request
        </a>

    </div>

    <!-- Search and Filters -->

    <form asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">

            <label class="form-label">
                Search
            </label>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Request ID, equipment or issue" />

        </div>

        <div class="col-md-3">

            <label class="form-label">
                Status
            </label>

            <select name="status"
                    class="form-select">

                <option value="">
                    All Statuses
                </option>

                <option value="Open"
                        selected="@(ViewBag.Status == "Open")">
                    Open
                </option>

                <option value="In Progress"
                        selected="@(ViewBag.Status == "In Progress")">
                    In Progress
                </option>

                <option value="On Hold"
                        selected="@(ViewBag.Status == "On Hold")">
                    On Hold
                </option>

                <option value="Completed"
                        selected="@(ViewBag.Status == "Completed")">
                    Completed
                </option>

            </select>

        </div>

        <div class="col-md-3">

            <label class="form-label">
                Priority
            </label>

            <select name="priority"
                    class="form-select">

                <option value="">
                    All Priorities
                </option>

                <option value="Low"
                        selected="@(ViewBag.Priority == "Low")">
                    Low
                </option>

                <option value="Medium"
                        selected="@(ViewBag.Priority == "Medium")">
                    Medium
                </option>

                <option value="High"
                        selected="@(ViewBag.Priority == "High")">
                    High
                </option>

                <option value="Critical"
                        selected="@(ViewBag.Priority == "Critical")">
                    Critical
                </option>

            </select>

        </div>

        <div class="col-md-2 d-flex align-items-end">

            <button type="submit"
                    class="btn btn-primary me-2">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>


    <!-- Requests Table -->

    <table class="table table-bordered table-striped">

        <thead>
            <tr>

                <th>Request ID</th>

                <th>Equipment</th>

                <th>Issue Title</th>

                <th>Priority</th>

                <th>Status</th>

                <th>Reported By</th>

                <th>Created Date</th>

                <th>Assigned To</th>

                <th>Action</th>

            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.RequestId
                        </td>

                        <td>
                            @{
                                var equipmentNames =
                                    ViewBag.EquipmentNames as Dictionary<string, string>;

                                var equipmentName =
                                    equipmentNames != null &&
                                    equipmentNames.ContainsKey(item.EquipmentId)
                                        ? equipmentNames[item.EquipmentId]
                                        : item.EquipmentId;
                            }

                            @equipmentName
                        </td>

                        <td>
                            @item.IssueTitle
                        </td>

                        <td>
                            @item.Priority
                        </td>

                        <td>
                            @item.Status
                        </td>

                        <td>
                            @item.ReportedBy
                        </td>

                        <td>
                            @item.CreatedDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @item.AssignedTo
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.RequestId"
                               class="btn btn-info btn-sm">
                                Open
                            </a>

                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="9"
                        class="text-center">

                        No maintenance requests found.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>